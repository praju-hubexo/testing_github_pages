{
  "openapi": "3.0.0",
  "info": {
    "title": "Time & Greeting API",
    "description": "A simple API to get current time and greet users by username",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Root Endpoint",
        "description": "Returns a welcome message and list of available endpoints",
        "operationId": "root_get",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "endpoints": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/time": {
      "get": {
        "summary": "Get Current Time",
        "description": "Returns the current date and time in multiple formats",
        "operationId": "get_time",
        "responses": {
          "200": {
            "description": "Current time information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "timestamp": {
                      "type": "string",
                      "description": "ISO format timestamp"
                    },
                    "date": {
                      "type": "string",
                      "description": "Date in YYYY-MM-DD format"
                    },
                    "time": {
                      "type": "string",
                      "description": "Time in HH:MM:SS format"
                    },
                    "day": {
                      "type": "string",
                      "description": "Day of the week"
                    },
                    "timezone": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/greet": {
      "get": {
        "summary": "Greet User (Query Parameter)",
        "description": "Greets a user by their username and shows the current time",
        "operationId": "greet_user",
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "description": "The name of the user to greet",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "Alice"
          }
        ],
        "responses": {
          "200": {
            "description": "Greeting response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "greeting": {
                      "type": "string"
                    },
                    "current_time": {
                      "type": "string"
                    },
                    "current_date": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Username is required"
          }
        }
      }
    },
    "/greet/{username}": {
      "get": {
        "summary": "Greet User (Path Parameter)",
        "description": "Alternative endpoint to greet a user using path parameter",
        "operationId": "greet_user_path",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "description": "The name of the user to greet",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Alice"
          }
        ],
        "responses": {
          "200": {
            "description": "Greeting response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "greeting": {
                      "type": "string"
                    },
                    "current_time": {
                      "type": "string"
                    },
                    "current_date": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Username cannot be empty"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Simple health check endpoint",
        "operationId": "health_check",
        "responses": {
          "200": {
            "description": "Health status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/info": {
      "get": {
        "summary": "Application Info",
        "description": "Returns application metadata",
        "operationId": "app_info",
        "responses": {
          "200": {
            "description": "Application information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "app_name": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "python_version": {
                      "type": "string"
                    },
                    "server": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "started_at": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
